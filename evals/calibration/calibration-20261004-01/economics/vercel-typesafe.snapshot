                      nav.scrollTo({ top: Math.min(Math.max(center, 0), maxScroll), behavior: 'instant' });
                    }
                  })();</script></nav></aside></div></div><!--&--><!--&--><!--&--><!--&--><div class="_6uRq_q_content"><span data-navigation-marker="content-Doc" style="width:1px;height:1px;opacity:0;position:absolute"></span><!--$--><!--/$--><script type="application/ld+json">{"@context":"https://schema.org","@type":"TechArticle","headline":"TypeSafe API with AI Gateway","description":"Point an existing TypeSafe client at AI Gateway by changing its base URL to route System One evaluation requests through it.","dateModified":"2026-09-21T14:47:02.000Z","author":{"@type":"Organization","name":"Vercel"},"publisher":{"@type":"Organization","name":"Vercel","url":"https://vercel.com"},"url":"https://vercel.com/docs/ai-gateway/sdks-and-apis/typesafe","image":{"@type":"ImageObject","url":"https://vercel.com/api/docs-og?title=TypeSafe%20API%20with%20AI%20Gateway&format=docs&sig=0e87674abe6351a01b9db01c66b172ab6a94c3e4062bf5adb7dcd226f1505208","width":"1200","height":"630"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Vercel Documentation","item":"https://vercel.com/docs"},{"@type":"ListItem","position":2,"name":"Build AI apps","item":"https://vercel.com"},{"@type":"ListItem","position":3,"name":"AI Gateway","item":"https://vercel.com/docs/agent-resources/vercel-mcp/tools/ai-gateway"},{"@type":"ListItem","position":4,"name":"SDKs & APIs","item":"https://vercel.com/docs/ai-gateway/sdks-and-apis"},{"@type":"ListItem","position":5,"name":"TypeSafe API","item":"https://vercel.com/docs/ai-gateway/sdks-and-apis/typesafe"}]}</script><div class="max-w-3xl mx-auto w-full"><div class="relative hidden h-0 items-center gap-x-3 lg:flex lg:h-6"><!--$?--><template id="B:7"></template><span aria-hidden="true" class="invisible whitespace-nowrap inline-block no-underline select-none text-label-14"> </span><!--/$--></div><div class="m-0 p-0" id="page-content"><div class="not-pros